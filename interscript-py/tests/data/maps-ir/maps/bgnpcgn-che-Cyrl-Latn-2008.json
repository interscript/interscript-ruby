̇ (U+00C7+0307)  ç̇ (U+00E7+0307)\n          Ş (U+015E)       ş (U+015F)","The Roman-script columns show only lowercase forms but, when applying the table, uppercase and lowercase Roman letters as appropriate should be used"]},"stages":[{"kind":"stage","name":"main","rules":[{"kind":"sub","from":{"kind":"group","items":[{"kind":"alias","name":"boundary"},{"kind":"string","value":"Е"}]},"to":{"kind":"string","value":"Ye"},"notBefore":{"kind":"group","items":[{"kind":"alias","name":"boundary"},{"kind":"string","value":"’"}]}},{"kind":"sub","from":{"kind":"group","items":[{"kind":"alias","name":"boundary"},{"kind":"string","value":"е"}]},"to":{"kind":"string","value":"ye"},"notBefore":{"kind":"group","items":[{"kind":"alias","name":"boundary"},{"kind":"string","value":"’"}]}},{"kind":"sub","from":{"kind":"string","value":"ккх"},"to":{"kind":"string","value":"qq"}},{"kind":"sub","from":{"kind":"string","value":"ккЪ"},"to":{"kind":"string","value":"q̇q̇"}},{"kind":"sub","from":{"kind":"string","value":"ККх"},"to":{"kind":"string","value":"QQ"}},{"kind":"sub","from":{"kind":"string","value":"ККЪ"},"to":{"kind":"string","value":"Q̇Q̇"}},{"kind":"parallel","rules":[{"kind":"sub","from":{"kind":"string","value":"А"},"to":{"kind":"any","of":[{"kind":"string","value":"A"},{"kind":"string","value":"Ə"}]}},{"kind":"sub","from":{"kind":"string","value":"Аь"},"to":{"kind":"string","value":"Ä"}},{"kind":"sub","from":{"kind":"string","value":"Б"},"to":{"kind":"string","value":"B"}},{"kind":"sub","from":{"kind":"string","value":"В"},"to":{"kind":"string","value":"V"}},{"kind":"sub","from":{"kind":"string","value":"Г"},"to":{"kind":"string","value":"G"}},{"kind":"sub","from":{"kind":"string","value":"ГӀ"},"to":{"kind":"string","value":"Ġ"}},{"kind":"sub","from":{"kind":"string","value":"Д"},"to":{"kind":"string","value":"D"}},{"kind":"sub","from":{"kind":"string","value":"Е"},"to":{"kind":"string","value":"E"}},{"kind":"sub","from":{"kind":"string","value":"Ё"},"to":{"kind":"string"